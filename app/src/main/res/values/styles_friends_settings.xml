<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Makes the "on" state of the Settings switches blue, as in the mockup -->
    <style name="ThemeOverlay.FS.Switch" parent="">
        <item name="colorPrimary">@color/fs_switch_blue</item>
        <item name="colorOnPrimary">@color/fs_card</item>
    </style>

    <!-- Base for the FS.* styles below -->
    <style name="FS" />

    <style name="FS.SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/fs_text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FS.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_fs_card</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <style name="FS.Avatar">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_fs_avatar</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/fs_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FS.NameText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/fs_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FS.SubText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/fs_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="FS.RowLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/fs_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>



</resources>
