<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/friends_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fs_background"
    android:orientation="vertical"
    tools:context=".FriendsFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- Header: Back link + centered title -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <TextView
                    android:id="@+id/btn_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:padding="4dp"
                    android:text="‹ Back"
                    android:textColor="@color/fs_primary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Friends"
                    android:textColor="@color/fs_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Search + Add -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_search_username"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:autofillHints="username"
                    android:background="@drawable/bg_fs_search"
                    android:hint="Search by username"
                    android:inputType="text"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/fs_text_primary"
                    android:textColorHint="@color/fs_text_hint"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_friend"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_marginStart="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="80dp"
                    android:text="Add"
                    android:textColor="@color/fs_card"
                    android:textStyle="bold"
                    app:backgroundTint="@color/fs_primary"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Friend Requests -->
            <TextView
                style="@style/FS.SectionTitle"
                android:layout_marginTop="24dp"
                android:text="Friend Requests (1)" />

            <LinearLayout style="@style/FS.Card">

                <TextView
                    style="@style/FS.Avatar"
                    android:text="JL" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FS.NameText"
                        android:text="Jordan Lee" />

                    <TextView
                        style="@style/FS.SubText"
                        android:text="\@jordan.lee" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_accept"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Accept"
                    android:textColor="@color/fs_card"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/fs_accept_green"
                    app:cornerRadius="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_decline"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Decline"
                    android:textColor="@color/fs_decline_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/fs_decline_gray"
                    app:cornerRadius="6dp" />
            </LinearLayout>

            <!-- My Friends header + Leaderboard link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/FS.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="My Friends (3)" />

                <TextView
                    android:id="@+id/link_leaderboard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Leaderboard ›"
                    android:textColor="@color/fs_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout style="@style/FS.Card">

                <TextView
                    style="@style/FS.Avatar"
                    android:text="MP" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FS.NameText"
                        android:text="Maya Patel" />

                    <TextView
                        style="@style/FS.SubText"
                        android:text="\@mayap" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12-day streak"
                    android:textColor="@color/fs_streak_orange"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout style="@style/FS.Card">

                <TextView
                    style="@style/FS.Avatar"
                    android:text="EB" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FS.NameText"
                        android:text="Ethan Brooks" />

                    <TextView
                        style="@style/FS.SubText"
                        android:text="\@ebrooks" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8-day streak"
                    android:textColor="@color/fs_streak_orange"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout style="@style/FS.Card">

                <TextView
                    style="@style/FS.Avatar"
                    android:text="SR" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FS.NameText"
                        android:text="Sofia Ramirez" />

                    <TextView
                        style="@style/FS.SubText"
                        android:text="\@sofi.ramirez" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2-day streak"
                    android:textColor="@color/fs_streak_orange"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
