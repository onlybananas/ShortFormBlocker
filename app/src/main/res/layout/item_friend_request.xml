<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/FS.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/requestAvatar"
        style="@style/FS.Avatar"
        android:text="AB" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/requestName"
            style="@style/FS.NameText"
            android:text="Display Name" />

        <TextView
            android:id="@+id/requestUsername"
            style="@style/FS.SubText"
            android:text="\@username" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_accept"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Accept"
        android:textColor="@color/fs_card"
        android:textSize="12sp"
        android:textStyle="bold"
        app:backgroundTint="@color/fs_accept_green"
        app:cornerRadius="6dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_decline"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Decline"
        android:textColor="@color/fs_decline_text"
        android:textSize="12sp"
        android:textStyle="bold"
        app:backgroundTint="@color/fs_decline_gray"
        app:cornerRadius="6dp" />

</LinearLayout>